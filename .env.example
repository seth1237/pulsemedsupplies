# ERP Integration — website fetches products & categories from the ERP catalog

# Local ERP (when developing against the admin upload on localhost)
ERP_API_BASE_URL=http://localhost:5010

# Production ERP API
# ERP_API_BASE_URL=https://backend.codewithseth.co.ke

# Required: your organization ID from ERP admin → Settings / System
ERP_ORG_ID=your-organization-id-here

# Catalogue source: `erp` uses ERP inventory, `local` uses public/products.json
CATALOG_SOURCE=erp

# Optional shared secret for website → ERP product photo uploads (recommended on Vercel)
# Must match WEBSITE_UPLOAD_SECRET / ERP_WEBSITE_UPLOAD_SECRET on the ERP server
# ERP_WEBSITE_UPLOAD_SECRET=replace-with-a-long-random-string

# Optional request timeout in milliseconds
# ERP_REQUEST_TIMEOUT=10000
