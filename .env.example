# ERP Integration — website fetches products & categories only
# Copy to .env.local and fill in your tenant org ID

# Production ERP API
ERP_API_BASE_URL=https://backend.codewithseth.co.ke

# Local ERP (when developing against localhost:5010)
# ERP_API_BASE_URL=http://localhost:5010

# Required: your organization ID from ERP admin → Settings / System
ERP_ORG_ID=your-organization-id-here

# Catalogue source: `local` uses public/products.json, `erp` uses the ERP API
# CATALOG_SOURCE=local

# Optional request timeout in milliseconds
# ERP_REQUEST_TIMEOUT=10000
